{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "backend", "run", "uvicorn", "app.main:app", "--reload", "--reload-dir", "app", "--port", "8010"],
